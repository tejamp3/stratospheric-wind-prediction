# Raw ERA5 data: ~220 MB, re-downloadable from the CDS with src/download_era5.py
data/raw/*.nc
data/raw/*.grib
data/raw/*.part

# Derived arrays and scalers: regenerated by src/train.py in seconds
data/processed/

# Sweep checkpoints: 32 disposable models, ~5 MB. The results that matter are
# in results/metrics/sweep.csv. The shipped models ARE committed - together they
# are under 600 KB, and it makes the repo usable without retraining.
models/lstm_sw_*.pt
models/lstm_cand_*.pt

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Credentials - NEVER commit
.cdsapirc

# OS
Thumbs.db
desktop.ini
.DS_Store
